@startuml
skinparam style strictuml
skinparam actorStyle stick
skinparam maxmessagesize 150

actor "Usuario" as user
participant "OfertasPageUI" as page
participant "Controlador" as api
participant "OfertaView" as view
participant "Oferta" as orm
database "BD" as db
participant "ModalDetalleOferta" as modal

activate user
user -> page : Entrar al Catálogo de ofertas
activate page

== Fase 1: Carga inicial de datos ==

page -> api : Pedir ofertas ( getOfertas() )
activate api

api -> view : Conseguir ofertas
activate view

view -> orm : Buscar ofertas activas ( all() )
activate orm

orm -> db : Seleccionar Ofertas con estado Activo
activate db
db --> orm : Lista de registros de la base de datos
deactivate db

orm --> view : Lista de ofertas (Objetos Python)
deactivate orm

view --> api : Datos de las ofertas en formato JSON
deactivate view

api --> page : Resultados de la API/Controlador
deactivate api

page -> page : Guardar datos ( setOfertas() )
page --> user : Mostrar el catálogo en pantalla

== Fase 2: Filtrado y búsqueda ==

loop Mientras el usuario busca y filtra opciones
    user -> page : Cambiar filtros o texto ( handleFiltroChange )
    page -> page : Filtrar lista
    page --> user : Actualizar tarjetas mostradas al instante
end

== Fase 3: Selección y detalles ==

user -> page : Clic en "Ver detalles" ( handleVerDetalle )
page -> page : Guardar oferta seleccionada ( setOfertaSeleccionada )

page -> modal ** : <<create>> Abrir ventana modal
activate modal
modal --> user : Mostrar los detalles completos de la oferta
deactivate modal

deactivate page
deactivate user
@enduml